# ==============================================================================
# Groundwater Resource Evaluation Backend - Environment Configuration Template
# ==============================================================================

# 1. Database Connection URL
# Local Development:
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/groundwater_db

# Production (e.g., Render Managed PostgreSQL):
# Note: Render provides connection URLs starting with postgres:// or postgresql://.
# The application automatically normalizes these to postgresql+psycopg:// at startup.
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a.oregon-postgres.render.com/groundwater_db

# 2. Allowed CORS Origins (comma-separated for multiple origins, or * for open access)
# Local React Dev Server & Production Preview:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Production Frontend (e.g., Vercel, Netlify, Render):
# CORS_ORIGINS=https://your-groundwater-frontend.vercel.app,https://your-domain.com
